{
	"id": "parts-studio",
	"status": "draft",
	"kind": "post",
	"tier": 2,
	"lane": "developer",
	"pattern": "mechanism",
	"notBefore": "2026-10-14T00:00:00Z",
	"covers": [
		"/segment",
		"workers/segment"
	],
	"scenario": {
		"format": "square",
		"steps": [
			{
				"goto": "https://three.ws/segment",
				"settle": 6000,
				"caption": "Paste any public 3D model link"
			},
			{
				"type": "https://three.ws/avatars/mannequin.glb",
				"into": "https://…/model.glb"
			},
			{
				"hold": 1200
			},
			{
				"click": "Segment",
				"awaits": "/api/forge-segment",
				"caption": "It splits the mesh into named parts"
			},
			{
				"expect": "top-1",
				"within": 240000,
				"film": true
			},
			{
				"read": "parts",
				"match": "Parts\\s*(\\d+)\\s"
			},
			{
				"click": "Show all",
				"caption": "Colour-coded, ready to orbit"
			},
			{
				"hold": 1600,
				"caption": "Named parts, found by geometry alone"
			},
			{
				"hold": 2200
			},
			{
				"drag": [
					[
						0.3,
						0.5
					],
					[
						0.6,
						0.5
					]
				],
				"ms": 2200,
				"caption": "Each part is its own piece you can turn"
			},
			{
				"hold": 2800
			}
		]
	},
	"probes": [
		{
			"type": "scenario"
		},
		{
			"type": "api",
			"name": "the mannequin model the reel segments is still served",
			"url": "https://three.ws/avatars/mannequin.glb",
			"expect": {
				"status": 200
			}
		}
	],
	"posts": [
		{
			"text": "Parts Studio is live on three.ws. Paste a link to a 3D model and it splits the mesh into named parts, cutting at disconnected shells and concave creases, so each piece can be isolated, hidden or exported on its own.\n\nThe mannequin in the reel came back as 24 parts, found from the geometry alone.",
			"media": [
				{
					"path": "public/x-media/parts-studio/reel.mp4",
					"probe": {
						"durationSec": 18.07,
						"width": 1080,
						"height": 1080,
						"fps": 30,
						"videoCodec": "h264",
						"pixFmt": "yuv420p"
					},
					"reel": true
				}
			]
		},
		{
			"text": "Agents get the same tool: segment_model over MCP, and a plain REST endpoint at /api/forge-segment. The segmentation worker runs on Google Cloud Run.\n\nPaste a link and try it: three.ws/segment"
		}
	],
