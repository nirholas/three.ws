{
	"steps": [
		{
			"id": "sync",
			"name": "python:3.12-bookworm",
			"entrypoint": "bash",
			"secretEnv": ["GITHUB_TOKEN"],
			"env": ["PUSH=${_PUSH}", "THREE_WS_REF=${_THREE_WS_REF}"],
			"args": [
				"-c",
				"set -euo pipefail\ngit clone -q --depth 1 --filter=blob:none --sparse --branch \"$$THREE_WS_REF\" https://github.com/nirholas/three.ws.git /workspace/three.ws\ngit -C /workspace/three.ws sparse-checkout set distributions\ncd /workspace/three.ws\nbash distributions/sync/run.sh\n"
			]
		}
	],
	"substitutions": {
		"_PUSH": "1",
		"_THREE_WS_REF": "main"
	},
	"availableSecrets": {
		"secretManager": [
			{
				"versionName": "projects/aerial-vehicle-466722-p5/secrets/three-ws-distributions-github-token/versions/latest",
				"env": "GITHUB_TOKEN"
			}
		]
	},
	"timeout": "2400s",
	"options": {
		"machineType": "E2_HIGHCPU_8",
		"logging": "CLOUD_LOGGING_ONLY"
	},
	"serviceAccount": "projects/aerial-vehicle-466722-p5/serviceAccounts/three-ws-build@aerial-vehicle-466722-p5.iam.gserviceaccount.com",
	"tags": ["three-ws-distributions-sync"]
}
