{
	"name": "three-ws-desktop",
	"productName": "three.ws Desktop",
	"version": "0.1.0",
	"description": "The three.ws agent console for macOS, Windows and Linux: sign in, chat with your agents, follow runs, approve what they spend, and keep the 3D companion on your desktop.",
	"author": "three.ws <support@three.ws> (https://three.ws)",
	"license": "Apache-2.0",
	"homepage": "https://three.ws/desktop",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/three.ws.git",
		"directory": "apps/desktop"
	},
	"private": true,
	"type": "module",
	"main": "src/main.js",
	"scripts": {
		"start": "electron .",
		"dev": "electron . --dev",
		"icons": "node scripts/make-icons.mjs",
		"bump": "node scripts/bump-version.mjs",
		"dist": "electron-builder --config electron-builder.config.cjs --publish never",
		"dist:mac": "electron-builder --config electron-builder.config.cjs --mac --publish never",
		"dist:win": "electron-builder --config electron-builder.config.cjs --win --publish never",
		"dist:linux": "electron-builder --config electron-builder.config.cjs --linux --publish never",
		"release:manifest": "node scripts/release-manifest.mjs",
		"release:mac": "bash scripts/release-mac.sh",
		"release:github": "node scripts/github-release.mjs"
	},
	"dependencies": {
		"@three-ws/companion": "file:../../packages/companion-sdk",
		"dompurify": "^3.4.15",
		"electron-updater": "^6.8.9",
		"marked": "^18.0.13",
		"smol-toml": "^1.8.0"
	},
	"devDependencies": {
		"electron": "^33.2.0",
		"electron-builder": "^25.1.8"
	}
}
