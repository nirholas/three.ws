# ────────────────────────────────────────────────────────────────────────────
# HQ - environment variables
# Copy to .env.local for local dev. The dashboard works with zero configuration;
# every var below only unlocks an optional lane or integration. Production sets
# these on the Cloud Run service (see docs/deploy-cloud-run.md).
# ────────────────────────────────────────────────────────────────────────────

# AI summaries (morning briefing, AI-powered analysis). Falls back to the
# browser ML lane (ONNX Runtime, offline) when unset.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Shared cache (Upstash Redis). Without these, each API route falls back to
# an in-process cache that does not survive a cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stocks (Finnhub)
FINNHUB_API_KEY=

# World events (ACLED conflict data)
ACLED_ACCESS_TOKEN=

# World events (UCDP conflict data)
UCDP_ACCESS_TOKEN=

# Wildfire detection (NASA FIRMS)
FIRMS_API_KEY=
NASA_FIRMS_API_KEY=

# Macro data (FRED, EIA)
FRED_API_KEY=
EIA_API_KEY=

# On-chain explorers (gas tracker, wallet tracker)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BSCSCAN_API_KEY=
THEGRAPH_API_KEY=

# Threat intelligence (exploit alerts and ledger)
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=

# Military aircraft tracking (OpenSky OAuth2, relay via WINGBITS)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
WINGBITS_API_KEY=

# Vessel tracking (AISStream)
AISSTREAM_API_KEY=
VITE_AISSTREAM_API_KEY=
AIS_SNAPSHOT_INTERVAL_MS=

# Custom domain / CDN purge (Cloudflare)
CLOUDFLARE_API_TOKEN=

# Local API sidecar (desktop app / local dev only; leave unset in production)
LOCAL_API_MODE=
LOCAL_API_PORT=
LOCAL_API_TOKEN=
LOCAL_API_REMOTE_BASE=
LOCAL_API_CLOUD_FALLBACK=
LOCAL_API_RESOURCE_DIR=
LOCAL_API_CACHE_PERSIST_MAX=
CACHE_TELEMETRY_LOG_EVERY=
WS_RELAY_URL=

# Server port (Cloud Run sets this automatically; default 8080/5173 otherwise)
PORT=
