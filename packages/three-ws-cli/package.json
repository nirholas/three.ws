{
  "name": "three-ws",
  "version": "0.1.0",
  "description": "One command to connect any MCP client to three.ws: sign in with OAuth or an API key, write the three.ws MCP servers into Claude Code, Claude Desktop, Cursor, Windsurf, VS Code, Codex, Gemini CLI or Hermes, and verify each with a live tools/list.",
  "keywords": [
    "three.ws",
    "mcp",
    "model-context-protocol",
    "cli",
    "oauth",
    "claude",
    "cursor",
    "vscode",
    "codex",
    "gemini",
    "solana",
    "agents"
  ],
  "author": "three.ws <support@three.ws> (https://three.ws)",
  "license": "Apache-2.0",
  "homepage": "https://three.ws/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/three.ws.git",
    "directory": "packages/three-ws-cli"
  },
  "bugs": {
    "url": "https://github.com/nirholas/three.ws/issues"
  },
  "type": "module",
  "bin": {
    "three-ws": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --root ../.. packages/three-ws-cli/tests",
    "publish:both": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "jsonc-parser": "^3.3.0",
    "smol-toml": "^1.3.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
