{
  "name": "@three-ws/cli",
  "version": "0.1.1",
  "description": "One command to connect any MCP client to three.ws: sign in with OAuth or an API key, write the three.ws MCP servers into Claude Code, Claude Desktop, Cursor, Windsurf, VS Code, IBM Bob, Codex, Gemini CLI or Hermes, print the connector fields for Grok Bot, and verify each with a live tools/list.",
  "keywords": [
    "three.ws",
    "mcp",
    "model-context-protocol",
    "cli",
    "oauth",
    "claude",
    "cursor",
    "vscode",
    "codex",
    "gemini",
    "grok",
    "solana",
    "agents",
    "grok-bot"
  ],
  "author": "three.ws <support@three.ws> (https://three.ws)",
  "license": "Apache-2.0",
  "homepage": "https://three.ws/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/three.ws.git",
    "directory": "packages/three-ws-cli"
  },
  "bugs": {
    "url": "https://github.com/nirholas/three.ws/issues"
  },
  "type": "module",
  "bin": {
    "three-ws": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --root ../.. packages/three-ws-cli/tests"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^2.1.2",
    "@solana-program/compute-budget": "^0.18.1",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@x402/core": "^2.26.0",
    "@x402/svm": "^2.14.0",
    "jsonc-parser": "^3.3.0",
    "smol-toml": "^1.3.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
