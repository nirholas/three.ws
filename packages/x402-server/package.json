{
  "name": "@three-ws/x402-server",
  "version": "0.2.0",
  "description": "The merchant side of x402 \u2014 turn any HTTP endpoint into a paid one. Issue 402 challenges, price SKUs, verify and settle the X-PAYMENT header on Solana and Base, and take a platform fee. Advertise the two main assets \u2014 USDC and $THREE \u2014 in one challenge. Includes a self-hostable Solana facilitator (verify, settle, anti-drain gate, sponsor guards) and an attack suite to test any facilitator.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./facilitator": {
      "types": "./src/facilitator/index.d.ts",
      "import": "./src/facilitator/index.js",
      "default": "./src/facilitator/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/attacks/*.test.js",
    "attack": "node bin/x402-server.js attack"
  },
  "keywords": [
    "x402",
    "402",
    "payment-required",
    "paywall",
    "usdc",
    "three",
    "solana",
    "base",
    "eip-3009",
    "merchant",
    "middleware",
    "agent-payments",
    "three.ws",
    "facilitator",
    "self-hosted"
  ],
  "author": "nirholas <support@three.ws>",
  "license": "Apache-2.0",
  "homepage": "https://three.ws",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/three.ws.git",
    "directory": "packages/x402-server"
  },
  "bugs": {
    "url": "https://github.com/nirholas/three.ws/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "x402-server": "./bin/x402-server.js"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.0",
    "bs58": ">=5.0.0",
    "@noble/curves": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    },
    "bs58": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    }
  }
}
