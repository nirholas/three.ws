name: "birefnet-general-lite"
backend: "onnxruntime"
max_batch_size: 0
input [
  {
    name: "input_image"
    data_type: TYPE_FP32
    dims: [ 1, 3, 1024, 1024 ]
  }
]
output [
  {
    name: "output_image"
    data_type: TYPE_FP32
    dims: [ 1, 1, 1024, 1024 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
model_warmup [
  {
    name: "zeros"
    batch_size: 1
    inputs {
      key: "input_image"
      value {
        data_type: TYPE_FP32
        dims: [ 1, 3, 1024, 1024 ]
        zero_data: true
      }
    }
  }
]
