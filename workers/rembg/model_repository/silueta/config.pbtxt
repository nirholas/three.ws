name: "silueta"
backend: "onnxruntime"
max_batch_size: 0
input [
  {
    name: "input.1"
    data_type: TYPE_FP32
    dims: [ 1, 3, 320, 320 ]
  }
]
output [
  {
    name: "1959"
    data_type: TYPE_FP32
    dims: [ 1, 1, 320, 320 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
model_warmup [
  {
    name: "zeros"
    batch_size: 1
    inputs {
      key: "input.1"
      value {
        data_type: TYPE_FP32
        dims: [ 1, 3, 320, 320 ]
        zero_data: true
      }
    }
  }
]
