# Upload allowlist for cloudbuild.verify.yaml (gitignore syntax; last match wins).
#
# Exactly the paths workers/agent-orders/Dockerfile COPYs, and nothing else. The
# repo-root .gcloudignore also re-includes dist/ and public/ for the three-ws-api
# image, which this worker never reads and which cost ~1.4 GB of upload.
#
# gitignore semantics cannot re-include a file whose parent directory is
# excluded, so /workers/ has to be re-included whole: an "!/workers/agent-orders/"
# line alone silently uploads nothing under workers/ and the build dies with
# "unable to evaluate symlinks in Dockerfile path".
/*
!/workers/
!/api/
!/src/
!/agent-payments-sdk/
!/package.json
!/package-lock.json
!/.npmrc
!/.dockerignore
# Single files the Dockerfile copies out of otherwise-excluded trees: re-include
# each parent directory, exclude its contents, then re-include the one file.
!/public/
/public/*
!/public/risk-ack.js
!/data/
/data/*
!/data/plans.json
!/data/mcp-catalog.json
!/community-skills/
/community-skills/*
!/community-skills/tools/
/community-skills/tools/*
!/community-skills/tools/registry.mjs
!/packages/
/packages/*
!/packages/avatar-agent-mcp/
/packages/avatar-agent-mcp/*
!/packages/avatar-agent-mcp/src/
/packages/avatar-agent-mcp/src/*
!/packages/avatar-agent-mcp/src/lib/
/packages/avatar-agent-mcp/src/lib/*
!/packages/avatar-agent-mcp/src/lib/jito-tip-accounts.js
**/node_modules/
**/.git/
