# Upload allowlist for cloudbuild.verify.yaml (gitignore syntax; last match wins).
# Only the trees workers/agent-mm/Dockerfile COPYs. /workers/ is re-included whole
# because gitignore cannot re-include a child of an excluded directory.
/*
!/workers/
!/api/
!/src/
!/agent-payments-sdk/
!/package.json
!/package-lock.json
!/.npmrc
!/.dockerignore
