# Upload allowlist for cloudbuild.verify.yaml (gitignore syntax; last match wins).
# Only the trees workers/robinhood-feed/Dockerfile COPYs. /workers/ is re-included whole
# because gitignore cannot re-include a child of an excluded directory.
/*
!/workers/
!/robinhood/
/robinhood/*
!/robinhood/robinhood-chain-sdk/
node_modules/
!/package.json
!/package-lock.json
!/.npmrc
!/.dockerignore
