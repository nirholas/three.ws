{
	"name": "three.ws",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
	"postCreateCommand": "npm install && cp -n .env.example .env.local || true",
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": { "label": "three.ws dev server", "onAutoForward": "openPreview" }
	},
	"customizations": {
		"vscode": {
			"extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "editorconfig.editorconfig"]
		}
	}
}
