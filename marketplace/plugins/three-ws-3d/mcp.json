{
  "mcpServers": {
    "three-ws-studio": {
      "type": "http",
      "url": "https://three.ws/api/mcp-studio"
    },
    "3d-agent": {
      "command": "npx",
      "args": [
        "-y",
        "@three-ws/mcp-server"
      ],
      "env": {
        "MCP_SVM_PAYMENT_ADDRESS": "${MCP_SVM_PAYMENT_ADDRESS:-}"
      }
    },
    "scene": {
      "command": "npx",
      "args": [
        "-y",
        "@three-ws/scene-mcp"
      ]
    },
    "avatar": {
      "command": "npx",
      "args": [
        "-y",
        "@three-ws/avatar-mcp"
      ]
    }
  }
}
