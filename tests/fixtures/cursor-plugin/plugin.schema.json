{
  "$comment": "Cursor Plugin manifest (.cursor-plugin/plugin.json). Cursor publishes no machine-readable schema, so this is a field-for-field transcription of the manifest tables at https://cursor.com/docs/reference/plugins (Required fields, Optional fields, Variables, Submission checklist; retrieved 2026-11-20) with the name pattern copied from scripts/validate-template.mjs in https://github.com/cursor/plugin-template at commit 46216072ac5750f782f95bb325b4d12b7c3ae9c9 (2026-04-24). additionalProperties is false because the reference defines the complete field set: a field it does not list is something a reviewer reads as noise or a mistake. Re-transcribe from the same two sources when Cursor changes the format.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cursor.com/docs/reference/plugins#cursor-plugin-manifest",
  "title": "Cursor Plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "^[A-Za-z]:[\\\\/]" }, { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }] }
    },
    "pathOrPaths": {
      "oneOf": [
        { "$ref": "#/definitions/relativePath" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/relativePath" } }
      ]
    },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "variableSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "object", "array"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "default": {},
        "enum": { "type": "array" },
        "const": {},
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variableSchema" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "items": { "$ref": "#/definitions/variableSchema" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "multipleOf": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "name": {
      "description": "Plugin identifier. Lowercase, kebab-case (alphanumerics, hyphens, and periods). Must start and end with an alphanumeric character.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "description": { "description": "Brief plugin description", "type": "string", "minLength": 1 },
    "version": {
      "description": "Semantic version (e.g., 1.0.0)",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "description": "Author info: name (required), email (optional)",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      }
    },
    "homepage": { "description": "URL to plugin homepage", "$ref": "#/definitions/url" },
    "repository": { "description": "URL to plugin repository", "$ref": "#/definitions/url" },
    "license": { "description": "License identifier (e.g., MIT)", "type": "string", "minLength": 1 },
    "keywords": { "description": "Tags for discovery and categorization", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "logo": {
      "description": "Relative path to a logo file in the repo, or an absolute URL",
      "oneOf": [{ "$ref": "#/definitions/url" }, { "allOf": [{ "$ref": "#/definitions/relativePath" }, { "not": { "pattern": "^https?://" } }] }]
    },
    "rules": { "description": "Path(s) to rule files or directories", "$ref": "#/definitions/pathOrPaths" },
    "agents": { "description": "Path(s) to agent files or directories", "$ref": "#/definitions/pathOrPaths" },
    "skills": { "description": "Path(s) to skill directories", "$ref": "#/definitions/pathOrPaths" },
    "commands": { "description": "Path(s) to command files or directories", "$ref": "#/definitions/pathOrPaths" },
    "hooks": {
      "description": "Path to hooks config file, or inline hook config",
      "oneOf": [{ "$ref": "#/definitions/relativePath" }, { "type": "object" }]
    },
    "mcpServers": {
      "description": "Path to MCP config file, inline MCP server config, or an array of either. Overrides default mcp.json discovery.",
      "oneOf": [
        { "$ref": "#/definitions/relativePath" },
        { "type": "object" },
        { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/definitions/relativePath" }, { "type": "object" }] } }
      ]
    },
    "variables": {
      "description": "JSON Schema declaring variable names substituted into ${VAR} placeholders. The top level must be { type: object, properties: {...} }.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variableSchema" } },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
