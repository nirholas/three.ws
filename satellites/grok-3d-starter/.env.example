# Copy this file to .env and fill in both keys. The server reads them; the
# browser never sees them.

# xAI API key. Create one at https://console.x.ai (API Keys).
XAI_API_KEY=

# three.ws API key. Making a model needs a three.ws account (a free one is
# enough). Create a key at https://three.ws/dashboard/api-keys
THREE_WS_API_KEY=

# Optional settings, shown with their defaults.
# XAI_MODEL=grok-4.7
# XAI_REASONING_EFFORT=low
# PORT=8080
# RATE_LIMIT_PER_MINUTE=8
# MAX_RENDER_WAIT_SECONDS=900
# Set to 1 behind a proxy that appends X-Forwarded-For (Cloud Run does).
# TRUST_PROXY=
