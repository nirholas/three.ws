# paper (default) books every fill at a real on-chain quote and never signs.
# live signs real pump.fun trades from the keypair below.
DESK_MODE=paper

# Live mode refuses to start unless this is set to I_UNDERSTAND_REAL_FUNDS.
DESK_LIVE_ACK=

# The trading keypair (live mode). Either a base58 secret key, a JSON byte
# array, or a path to a Solana CLI keypair file in DESK_KEYPAIR.
SOLANA_PRIVATE_KEY=
DESK_KEYPAIR=

# Any Solana mainnet RPC. The public endpoint works but rate-limits hard;
# a dedicated RPC keeps position marks fresh.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Starting paper balance, in SOL.
DESK_PAPER_SOL=5

# Where treasury sweeps surplus profit in live mode. Leave blank to keep
# everything in the trading wallet (sweeps are then reported, not sent).
DESK_COLD_WALLET=

# Dashboard. Binds to localhost only unless you change the host.
DESK_PORT=4180
DESK_HOST=127.0.0.1

# Optional: lets the head of desk write its hourly review memo. Decisions are
# always made from the numbers; the memo only narrates them.
ANTHROPIC_API_KEY=

# Optional: a desk config other than ./desk.config.json, and where the desk
# keeps its state (default ./data).
DESK_CONFIG=
DESK_DATA_DIR=

# The Oracle this desk reads. Defaults to the public three.ws endpoint.
ORACLE_BASE_URL=https://three.ws
