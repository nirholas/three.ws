{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.nirholas/three.ws",
	"title": "three.ws Avatars & Agents",
	"websiteUrl": "https://three.ws",
	"icons": [
		{
			"src": "https://three.ws/three-ws-mcp-icon.svg",
			"mimeType": "image/svg+xml",
			"sizes": ["any"]
		}
	],
	"description": "3D avatars, embeds, glTF tools, agent memory, and on-chain agent identity from three.ws.",
	"repository": {
		"url": "https://github.com/nirholas/three.ws",
		"source": "github"
	},
	"version": "1.0.1",
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://three.ws/api/mcp"
		}
	],
	"_meta": {
		"io.modelcontextprotocol.registry/publisher-provided": {
			"resources": [
				{
					"uri": "three://me",
					"name": "me",
					"title": "Your account",
					"mimeType": "application/json"
				},
				{
					"uri": "three://agents",
					"name": "agents",
					"title": "Your agents",
					"mimeType": "application/json"
				},
				{
					"uri": "three://marketplace",
					"name": "marketplace",
					"title": "Skill marketplace",
					"mimeType": "application/json"
				},
				{
					"uri": "three://models",
					"name": "models",
					"title": "Model catalog",
					"mimeType": "application/json"
				},
				{
					"uri": "three://wallets",
					"name": "wallets",
					"title": "All agent wallets",
					"mimeType": "application/json"
				},
				{
					"uri": "three://launches",
					"name": "launches",
					"title": "Your token launches",
					"mimeType": "application/json"
				},
				{
					"uri": "three://x402/services",
					"name": "x402-services",
					"title": "x402 service catalog",
					"mimeType": "application/json"
				}
			],
			"resourceTemplates": [
				{
					"uriTemplate": "three://agents/{agentId}",
					"name": "agent",
					"title": "Agent",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/wallet",
					"name": "agent-wallet",
					"title": "Agent wallet",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/usage",
					"name": "agent-usage",
					"title": "Agent usage",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/chat",
					"name": "agent-chat",
					"title": "Agent chat history",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/runs",
					"name": "agent-runs",
					"title": "Agent runs",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/runs/{runId}",
					"name": "agent-run",
					"title": "Agent run",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/orders",
					"name": "agent-orders",
					"title": "Agent open orders",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/dca",
					"name": "agent-dca",
					"title": "Agent DCA strategies",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://agents/{agentId}/intents",
					"name": "agent-intents",
					"title": "Agent wallet intents",
					"mimeType": "application/json"
				}
			],
			"prompts": [
				{
					"name": "get-started",
					"title": "Get started with three.ws",
					"arguments": []
				},
				{
					"name": "create-agent",
					"title": "Create an agent",
					"arguments": ["name", "persona", "model"]
				},
				{
					"name": "trade",
					"title": "Research and trade a token",
					"arguments": ["agentId", "token"]
				},
				{
					"name": "launch-token",
					"title": "Launch a token",
					"arguments": ["agentId", "name", "symbol"]
				},
				{
					"name": "hire-agent",
					"title": "Hire an agent for a task",
					"arguments": ["task"]
				},
				{
					"name": "review-costs",
					"title": "Review costs",
					"arguments": ["agentId"]
				},
				{
					"name": "setup-automations",
					"title": "Set up automations",
					"arguments": ["agentId"]
				},
				{
					"name": "setup-dca",
					"title": "Set up dollar-cost averaging",
					"arguments": ["agentId"]
				},
				{
					"name": "explore-marketplace",
					"title": "Explore the marketplace",
					"arguments": []
				},
				{
					"name": "explore-x402",
					"title": "Explore x402 services",
					"arguments": ["capability"]
				},
				{
					"name": "earn-yield",
					"title": "Earn yield",
					"arguments": ["agentId"]
				},
				{
					"name": "perps",
					"title": "Trade perpetuals",
					"arguments": ["agentId"]
				},
				{
					"name": "predictions",
					"title": "Prediction markets",
					"arguments": ["agentId"]
				},
				{
					"name": "embed-avatar",
					"title": "Embed an agent on a website",
					"arguments": ["agentId"]
				}
			]
		}
	}
}
