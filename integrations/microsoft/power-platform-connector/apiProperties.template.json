{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2generic",
          "clientId": "${PP_OAUTH_CLIENT_ID}",
          "scopes": [
            "profile",
            "agents:read",
            "offline_access"
          ],
          "redirectMode": "GlobalPerConnector",
          "properties": {
            "IsFirstParty": "False",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "authorizationUrlTemplate": {
              "value": "https://three.ws/oauth/authorize"
            },
            "authorizationUrlQueryStringTemplate": {
              "value": "?client_id={ClientId}&response_type=code&redirect_uri={RedirectUrl}&scope={Scopes}&state={State}&code_challenge={CodeChallenge}&code_challenge_method=S256"
            },
            "tokenUrlTemplate": {
              "value": "https://three.ws/oauth/token"
            },
            "tokenBodyTemplate": {
              "value": "client_id={ClientId}&grant_type=authorization_code&code={Code}&redirect_uri={RedirectUrl}&code_verifier={CodeVerifier}"
            },
            "refreshUrlTemplate": {
              "value": "https://three.ws/oauth/token"
            },
            "refreshBodyTemplate": {
              "value": "client_id={ClientId}&grant_type=refresh_token&refresh_token={RefreshToken}"
            },
            "scopeListDelimiter": {
              "value": " "
            }
          }
        },
        "uiDefinition": {
          "displayName": "Sign in with three.ws",
          "description": "Sign in with your three.ws account to list your agents and talk to them.",
          "tooltip": "You are sent to three.ws to sign in and approve access.",
          "constraints": {
            "required": "true",
            "hidden": "false"
          }
        }
      }
    },
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Identify connector traffic",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "X-Threews-Client",
          "x-ms-apimTemplateParameter.value": "power-platform-connector",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      }
    ],
    "iconBrandColor": "#080814",
    "capabilities": [
      "actions"
    ],
    "publisher": "three.ws",
    "stackOwner": "three.ws"
  }
}
