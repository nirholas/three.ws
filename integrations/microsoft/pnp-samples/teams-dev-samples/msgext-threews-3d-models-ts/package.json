{
  "name": "msgext-threews-3d-models-ts",
  "version": "1.0.0",
  "description": "Teams message extension and link unfurl that shares three.ws 3D models and agents as Adaptive Cards with a stage view",
  "engines": {
    "node": ">=22 <25"
  },
  "author": "nirholas",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
    "dev:teamsfx:playground": "env-cmd --silent -f .localConfigs.playground npm run dev",
    "dev:teamsfx:launch-playground": "env-cmd --silent -f env/.env.playground agentsplayground start",
    "clean": "rimraf ./dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "tsc --build",
    "start": "node .",
    "dev": "nodemon --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
    "watch": "nodemon --exec \"npm run start\""
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@microsoft/teams.api": "^2.0.0",
    "@microsoft/teams.apps": "^2.2.1",
    "@microsoft/teams.cards": "^2.0.0",
    "@microsoft/teams.common": "^2.0.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.5.4",
    "dotenv": "^16.4.5",
    "env-cmd": "^11.0.0",
    "eslint": "^10.0.0",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "glob@>=9.0.0 <14.0.2": "^14.0.6"
  }
}
