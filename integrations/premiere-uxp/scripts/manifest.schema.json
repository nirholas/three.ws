{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UXP plugin manifest v5 (Premiere Pro panel), the fields this plugin uses",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "main", "host", "entrypoints", "requiredPermissions"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "const": 5 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 45 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "main": { "type": "string", "pattern": "\\.html$" },
    "host": {
      "type": "object",
      "required": ["app", "minVersion"],
      "additionalProperties": false,
      "properties": {
        "app": { "const": "premierepro" },
        "minVersion": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "maxVersion": { "type": "string" }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id", "label"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["panel", "command"] },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "label": { "type": "object", "required": ["default"], "properties": { "default": { "type": "string", "minLength": 1 } } },
          "minimumSize": { "$ref": "#/definitions/size" },
          "maximumSize": { "$ref": "#/definitions/size" },
          "preferredDockedSize": { "$ref": "#/definitions/size" },
          "preferredFloatingSize": { "$ref": "#/definitions/size" },
          "icons": { "type": "array", "items": { "$ref": "#/definitions/icon" } }
        }
      }
    },
    "icons": { "type": "array", "items": { "$ref": "#/definitions/icon" } },
    "requiredPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domains": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://(\\*\\.)?[a-z0-9.-]+\\.[a-z]{2,}$" } }
          }
        },
        "localFileSystem": { "enum": ["request", "plugin", "fullAccess"] },
        "launchProcess": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemes": { "type": "array", "items": { "enum": ["https"] } },
            "extensions": { "type": "array", "maxItems": 0 }
          }
        }
      }
    }
  },
  "definitions": {
    "size": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 100 }, "height": { "type": "integer", "minimum": 100 } } },
    "icon": {
      "type": "object",
      "required": ["width", "height", "path"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "path": { "type": "string" },
        "scale": { "type": "array", "items": { "enum": [1, 2] } },
        "theme": { "type": "array", "items": { "enum": ["all", "lightest", "light", "medium", "dark", "darkest"] } },
        "species": { "type": "array", "items": { "enum": ["generic", "pluginList", "toolbar"] } }
      }
    }
  }
}
