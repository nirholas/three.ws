{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "three-ws",
  "title": "Three.ws Forge",
  "description": "Generate a textured 3D model (GLB) from a text prompt with the free three.ws Forge lane.",
  "icon": "extension-icon.png",
  "author": "three_ws",
  "categories": ["Design Tools", "Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "forge-model",
      "title": "Forge a 3D Model",
      "subtitle": "three.ws",
      "description": "Describe an object, get a downloadable GLB and a browser viewer link.",
      "mode": "view",
      "arguments": [
        {
          "name": "prompt",
          "placeholder": "a small wooden chair",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "tier",
      "type": "dropdown",
      "title": "Quality Tier",
      "description": "Draft is fastest. Standard adds 2K textures. High uses the deepest sampler budget.",
      "required": false,
      "default": "draft",
      "data": [
        { "title": "Draft (fast, low poly)", "value": "draft" },
        { "title": "Standard (textured)", "value": "standard" },
        { "title": "High (maximum detail)", "value": "high" }
      ]
    },
    {
      "name": "baseUrl",
      "type": "textfield",
      "title": "API Base URL",
      "description": "Leave empty to use https://three.ws.",
      "required": false,
      "default": ""
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run"
  }
}
