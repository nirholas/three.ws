{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.nirholas/threews-3d-studio",
	"title": "three.ws 3D Studio",
	"websiteUrl": "https://three.ws",
	"icons": [
		{
			"src": "https://three.ws/three-ws-mcp-icon.svg",
			"mimeType": "image/svg+xml",
			"sizes": ["any"]
		}
	],
	"description": "Turn text or an image into an animation-ready 3D model (GLB): generate, rig, animate, retexture.",
	"repository": {
		"url": "https://github.com/nirholas/three.ws",
		"source": "github"
	},
	"version": "1.0.1",
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://three.ws/api/mcp-3d"
		}
	],
	"_meta": {
		"io.modelcontextprotocol.registry/publisher-provided": {
			"resources": [
				{
					"uri": "three://me",
					"name": "me",
					"title": "Your account",
					"mimeType": "application/json"
				},
				{
					"uri": "three://agents",
					"name": "agents",
					"title": "Your agents",
					"mimeType": "application/json"
				},
				{
					"uri": "three://models",
					"name": "models",
					"title": "Model catalog",
					"mimeType": "application/json"
				}
			],
			"resourceTemplates": [
				{
					"uriTemplate": "three://agents/{agentId}",
					"name": "agent",
					"title": "Agent",
					"mimeType": "application/json"
				},
				{
					"uriTemplate": "three://assets/{id}",
					"name": "asset",
					"title": "3D asset",
					"mimeType": "application/json"
				}
			],
			"prompts": [
				{
					"name": "get-started",
					"title": "Get started with three.ws",
					"arguments": []
				},
				{
					"name": "generate-3d",
					"title": "Generate a 3D model",
					"arguments": ["prompt"]
				}
			]
		}
	}
}
