{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/awesome-agent-payments/entries.schema.json",
  "title": "awesome-agent-payments entries",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "url", "repo", "category", "chain", "description", "status", "added"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
      "repo": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
      "category": { "type": "string", "description": "An id from data/categories.json" },
      "chain": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "solana, base, multi, none, bitcoin, or another chain slug" },
      "description": { "type": "string", "minLength": 1, "maxLength": 160 },
      "status": { "enum": ["active", "early", "archived"] },
      "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
