{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/awesome-agent-protocols/entries.schema.json",
  "title": "awesome-agent-protocols entries",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "url", "repo", "category", "chain", "description", "status", "added"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "name": {"type": "string", "minLength": 1, "maxLength": 80},
      "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
      "repo": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
      "category": {"type": "string", "description": "An id from categories.json."},
      "chain": {"type": "string", "enum": ["none", "solana", "evm", "multi"], "description": "none unless the project is onchain."},
      "description": {"type": "string", "minLength": 10, "maxLength": 160},
      "status": {"type": "string", "enum": ["active", "early", "archived"]},
      "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }
  }
}
