{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awesome-robinhood-crypto/entries.schema.json",
  "title": "awesome-robinhood-crypto entries",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "url", "repo", "category", "chain", "description", "status", "added"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Unique kebab-case identifier." },
      "name": { "type": "string", "minLength": 1, "maxLength": 80 },
      "url": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Canonical project or documentation URL." },
      "repo": { "type": ["string", "null"], "format": "uri", "pattern": "^https://", "description": "Source repository URL, or null when there is none." },
      "category": { "type": "string", "description": "An id from categories.json." },
      "chain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "For example robinhood-chain, solana, multi or none." },
      "description": { "type": "string", "minLength": 10, "maxLength": 160, "description": "One factual sentence." },
      "status": { "enum": ["active", "early", "archived"] },
      "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
