{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.nirholas/threews-grok",
	"title": "three.ws for Grok",
	"websiteUrl": "https://three.ws/docs/grok",
	"icons": [
		{
			"src": "https://three.ws/three-ws-mcp-icon.svg",
			"mimeType": "image/svg+xml",
			"sizes": ["any"]
		}
	],
	"description": "Free 3D studio for Grok Bot; signed in: your agents and read-only Solana market intel. Never spends.",
	"repository": {
		"url": "https://github.com/nirholas/three.ws",
		"source": "github"
	},
	"version": "1.0.0",
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://three.ws/api/mcp-grok"
		}
	],
	"_meta": {
		"io.modelcontextprotocol.registry/publisher-provided": {
			"prompts": [
				{
					"name": "agent-get-started",
					"title": "Get started as an autonomous agent",
					"arguments": []
				},
				{
					"name": "daily-3d-brief",
					"title": "Daily 3D brief",
					"arguments": ["topic"]
				},
				{
					"name": "asset-pack",
					"title": "Themed asset pack",
					"arguments": ["theme", "count"]
				},
				{
					"name": "avatar-from-photo",
					"title": "Avatar from a photo",
					"arguments": ["image_url"]
				},
				{
					"name": "agent-report",
					"title": "Agent status report",
					"arguments": ["agentId"]
				},
				{
					"name": "market-brief",
					"title": "Solana market brief",
					"arguments": ["focus", "count"]
				}
			]
		}
	}
}
